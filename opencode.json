{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/ox-alpha-free-unlimited",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/*", "effect": "allow" }
  ],
  "agents": {
    "orchestrator": {
      "description": "Lead orchestrator: plans, delegates every unit of work to sub-agents, tracks the dependency graph, verifies results. Never implements anything itself.",
      "mode": "all",
      "model": "opencode/ox-alpha-free-unlimited#max",
      "color": "#4f9cf9",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "worker": {
      "description": "Implementation worker: executes one ticket end-to-end with TDD discipline (red-green-refactor), commits with the ticket ID referenced, reports what was built and what remains.",
      "mode": "subagent",
      "model": "openrouter/stealth/ox-alpha#high",
      "color": "#59c98f"
    }
  }
}
