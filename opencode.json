{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow",
      "~/.cache/*": "allow"
    }
  }
}
